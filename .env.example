# Copy to .env and fill in. Environment variables set elsewhere take precedence.

# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First-time setup from another computer: open /setup?token=<SETUP_TOKEN>
SETUP_TOKEN=

# Alternatively create the first administrator directly (only if there are no users yet)
#ADMIN_USER=admin
#ADMIN_PASSWORD=

# 1 behind HTTPS
COOKIE_SECURE=0

# Address shown in QR codes, e.g. https://feedback.example.org
#PUBLIC_URL=

# en or de, used when the browser language is not supported
DEFAULT_LANG=en

# SQLite file; 0 for SQLITE_WAL on network file systems (NFS)
#DB_PATH=data/tapinion.sqlite3
#SQLITE_WAL=1
